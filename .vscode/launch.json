{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/packages/plugin_emdash_r2_asset_access/src/plugin.ts",
      "outFiles": ["${workspaceFolder}/**/*.js"]
    },
    {
      "name": "Launch Emdash Admin",
      "type": "chrome",
      "request": "launch",
      "browserLaunchLocation": "ui",
      "url": "http://127.0.0.1:4321/_emdash/api/auth/dev-bypass?redirect=/_emdash/admin/",
      "webRoot": "${workspaceFolder}/hosts/web-cloudflare"
    }
  ]
}
