{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Node attach",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "cwd": "${workspaceFolder}",
      "resolveSourceMapLocations": null,
      "attachExistingChildren": false,
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch Emdash Admin",
      "type": "chrome",
      "request": "launch",
      "browserLaunchLocation": "ui",
      "url": "http://127.0.0.1:4321/_emdash/api/auth/dev-bypass?redirect=/_emdash/admin/",
      "webRoot": "${workspaceFolder}/hosts/web-cloudflare",
      "pathMapping": {
        "/@fs/": "/"
      },
      "windows": {
        "pathMapping": {
          "/@fs/": ""
        }
      }
    }
  ],
  "compounds": [
    {
      "name": "Test sandboxed plugin + Emdash admin",
      "configurations": ["Node attach", "Launch Emdash Admin"]
    }
  ]
}
